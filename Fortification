​<!-- Script for Interactive Pagination -->
<script>
let currentPage = 1;
const totalPages = 10;
​function updateView() {
// Hide all pages, show current
document.querySelectorAll('.page-content').forEach(el => {
el.classList.remove('active');
});
document.querySelector(.page-content[data-page="${currentPage}"]).classList.add('active');
​// Update badge & counter text
document.getElementById('page-title-badge').innerText = الصفحة ${currentPage} من ${totalPages};
document.getElementById('current-page-num').innerText = currentPage;
​// Update buttons state
document.getElementById('prev-btn').disabled = currentPage === 1;
document.getElementById('next-btn').disabled = currentPage === totalPages;
​// Scroll to top of container smoothly
window.scrollTo({ top: 0, behavior: 'smooth' });
}
​function changePage(direction) {
if (currentPage + direction >= 1 && currentPage + direction <= totalPages) {
currentPage += direction;
updateView();
}
}
</script>
</body>
</html>

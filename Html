<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المنصة الافتراضية - مدارس كامبريدج سيتي الدولية</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #050D1F;
            color: #ffffff;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between p-4 md:p-8">

    <!-- Header -->
    <header class="text-center py-6 border-b border-[#00D9FF]/30">
        <h1 class="text-2xl md:text-3xl font-bold text-[#00D9FF] tracking-wide">مدارس كامبريدج سيتي الدولية</h1>
        <p class="text-sm text-[#2CEAA3] mt-2">المنصة الافتراضية للتعليم الإلكتروني</p>
    </header>

    <!-- Main Content -->
    <main class="max-w-2xl mx-auto w-full my-8 space-y-6">
        <!-- Welcome Card -->
        <div class="bg-[#0b162c] border border-[#00D9FF]/40 rounded-2xl p-6 shadow-xl shadow-[#00D9FF]/10 text-center">
            <h2 class="text-xl font-bold text-[#2CEAA3] mb-3">مرحباً بكم في العام الدراسي الجديد</h2>
            <p class="text-gray-300 text-sm leading-relaxed">
                نعمل جاهدين لتقديم أفضل تجربة تعليمية رقمية لطلابنا الأعزاء وبناء مستقبل مشرق.
            </p>
        </div>

        <!-- Supervisors Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-[#0b162c] border border-[#2CEAA3]/40 rounded-xl p-4 text-center shadow-md">
                <h3 class="font-bold text-[#00D9FF] text-sm">إشراف القسم</h3>
                <p class="text-gray-200 mt-1 font-semibold">كمارا</p>
            </div>
            <div class="bg-[#0b162c] border border-[#2CEAA3]/40 rounded-xl p-4 text-center shadow-md">
                <h3 class="font-bold text-[#00D9FF] text-sm">التنسيق والمتابعة</h3>
                <p class="text-gray-200 mt-1 font-semibold">عزوز جنترة</p>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="text-center py-4 text-xs text-gray-500 border-t border-gray-800">
        جميع الحقوق محفوظة © مدارس كامبريدج سيتي الدولية 2026
    </footer>

</body>
</html>
